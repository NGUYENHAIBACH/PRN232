@model List<User>
@{
}

<h2>User List</h2>
<table>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Username</th>
        <th>Email</th>
        <th>City</th>
        <th>Phone</th>
        <th>Website</th>
        <th>Company</th>
    </tr>
    @{
        foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>@user.Address.City</td>
                <td>@user.Phone</td>
                <td>@user.Website</td>
                <td>@user.Company.Name</td>
            </tr>
        }
    }
</table>

@model List<Todo>
@{
}

<h2>Todo List</h2>
<table>
    <tr>
        <th>UserId</th>
        <th>Id</th>
        <th>Title</th>
        <th>Completed</th>
    </tr>
    @{
        foreach (var todo in Model)
        {
            <tr>
                <td>@todo.UserId</td>
                <td>@todo.Id</td>
                <td>@todo.Title</td>
                <td>@todo.Completed</td>
            </tr>
        }
    }
</table>

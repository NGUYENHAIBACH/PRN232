@{
}

@model List<Comment>

<h2>Comment List</h2>
<table>
    <tr>
        <th>Id</th>
        <th>PostId</th>
        <th>Name</th>
        <th>Email</th>
    </tr>

    @foreach (var comment in Model)
    {
        <tr>
            <td>@comment.Id</td>
            <td>@comment.PostId</td>
            <td>@comment.Name</td>
            <td>@comment.Email</td>
        </tr>
    }
</table>
@model List<Post>
@{
}

<h2>Posts/List</h2>
<h2><a href="Create">Create</a></h2>
<table>
    <tr>
        <th>UserId</th>
        <th>Id</th>
        <th>Title</th>
        <th>Action</th>
    </tr>
    @{
        foreach(var post in Model)
        {
            <tr>
                <td>@post.UserId</td>
                <td>@post.Id</td>
                <td>@post.Title</td>
                <td>
                    <a asp-action="Detail" asp-controller="Posts" asp-route-id="@post.Id" class="btn btn-info" >Detail</a>
                    <a href="Update/@post.Id" class="btn btn-warning">Update</a>
                    <a href="Delete/@post.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    }
</table>


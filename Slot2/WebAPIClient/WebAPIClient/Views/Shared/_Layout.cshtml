<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - WebAPIClient</title>

    <!-- Bootstrap CSS qua CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Posts" asp-action="List">WebAPIClient</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link" asp-controller="Posts" asp-action="List">Posts</a>
                <a class="nav-link" asp-controller="Comments" asp-action="Index">Comments</a>
                <a class="nav-link" asp-controller="Photos" asp-action="Index">Photos</a>
                <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
                <a class="nav-link" asp-controller="Todos" asp-action="Index">Todos</a>
                <a class="nav-link" asp-controller="Albums" asp-action="Index">Albums</a>

            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <!-- Bootstrap JS (bundle kèm Popper) - cần cho dropdown, dismissible alert, modal... -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model List<Album>
@{
}

<h2>Album List</h2>
<table>
    <tr>
        <th>UserId</th>
        <th>Id</th>
        <th>Title</th>
    </tr>
    @{
        foreach (var album in Model)
        {
            <tr>
                <td>@album.UserId</td>
                <td>@album.Id</td>
                <td>@album.Title</td>
            </tr>
        }
    }
</table>

@using WebApiClient.Models
@model List<Post>
@{
}
<h3>/Posts/List</h3>
<table>
    <tr>
        <th>UserId</th>
        <th>Id</th>
        <th>Title</th>
        <th></th>
    </tr>
    @foreach (var post in Model)
    {
        <tr>
            <td>@post.UserId</td>
            <td>@post.Id</td>
            <td>@post.Title</td>
            <td><a href="/Posts/Detail/@post.Id">Xem</a></td>
        </tr>
    }
</table>
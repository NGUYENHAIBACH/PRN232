@page "/Ticket/{id:int}"
@model Q2RazorPage.Pages.Ticket.DetailModel

@if (Model.Ticket == null)
{
    <p id="p_notfound">Ticket not found.</p>
    <p id="p_back"><a id="a_back" href="/Ticket">Back to list</a></p>
    return;
}
<div class="details-wrap">
    <div class="bill-card">
        <h3>Ticket Bill Information</h3>
        <div class="bill-item"><strong>Ticket ID:</strong> <span id="span_@Model.Ticket.TicketID">@Model.Ticket.TicketID</span></div>
        <div class="bill-item"><strong>Viewer Email:</strong> <span id="span_@Model.Ticket.Email">@Model.Ticket.Email</span></div>
        <div class="bill-item"><strong>Show Time:</strong> <span id="span_showTime">@Model.Ticket.ShowTime.ToString("yyyy-MM-dd HH:mm")</span></div>
    </div>

    <h4 style="margin-bottom: 15px; border-bottom: 1px solid #dee2e6; padding-bottom: 10px; width: 750px;">Purchased Movie List</h4>

    <table class="details-table">
        <thead>
            <tr>
                <th style="width: 280px;">Movie Title</th>
                <th style="width: 120px;">Quantity</th>
                <th style="width: 150px;">Total Cost</th>
                <th style="width: 200px;">Loyalty Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Ticket.Bookings)
            {
                decimal revenue = b.Quantity * b.BasePrice;
                <tr>
                    <td id="td_@(b.Title)_@b.MovieID">@b.Title</td>
                    <td id="td_qty_@b.MovieID">@b.Quantity</td>
                    <td id="td_cost_@b.MovieID">@revenue.ToString("0.00")</td>
                    <td id="td_status_@b.MovieID">
                        @if (revenue > 150000)
                        {
                            <span class="badge-vip">VIP Booking</span>
                        }
                        else
                        {
                            <span class="badge-standard">Standard Booking</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p id="p_back"><a id="a_back" href="/Ticket">Back to list</a></p>
